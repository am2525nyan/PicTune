{
  "firestore": { "rules": "firebase/firestore.rules" },
  "storage": { "rules": "firebase/storage.rules" },
  "hosting": {
    "site": "sotugyou-7ea16",
    "public": "firebase/hosting",
    "ignore": ["firebase.json", "**/node_modules/**"],
